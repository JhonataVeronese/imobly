NODE_ENV=development
PORT=3000
# URL pública da API (usada para montar a URL de webhook exibida ao corretor). Para Z-API real precisa ser HTTPS (ex.: túnel ngrok/cloudflared).
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://imobzap:imobzap@127.0.0.1:5432/imobzap?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=troque-este-segredo-com-32-caracteres-ou-mais
# Chave mestra (32 bytes em base64) para cifrar credenciais de provedores. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# local = disco (./data/storage), s3 = qualquer storage compatível com S3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=imobzap-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Expiração das URLs assinadas entregues ao provedor (segundos)
ASSET_URL_TTL_SECONDS=3600
# Como entregar mídia ao provedor: "url" (URL assinada — exige storage acessível pela internet) ou "base64"
ASSET_DELIVERY=base64

MAX_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=15728640

# Envio em fila, com ritmo por número de WhatsApp (cada número tem a própria fila, 1 envio por vez).
# Rajadas são o principal motivo de restrição de números: os padrões abaixo são conservadores
# (~30 s entre contatos, pausa de 10 min a cada 40, até 300/dia, das 8h às 20h).
# Número novo ou recém-conectado: comece com SEND_DAILY_CAP baixo (50–100) e aumente aos poucos.
SEND_MAX_ATTEMPTS=5
SEND_MIN_INTERVAL_MS=20000
SEND_JITTER_MS=20000
# Espera entre as partes da mesma mensagem (foto+texto, depois PDF)
SEND_PART_INTERVAL_MS=3000
SEND_BATCH_SIZE=40
SEND_BATCH_PAUSE_MS=600000
SEND_DAILY_CAP=300
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=20
SEND_TIMEZONE=America/Sao_Paulo

# Provedor fake: simula webhooks de status automaticamente (só para demo local)
FAKE_AUTO_STATUS=true

LOG_LEVEL=info

# Fase 0 — probe contra a Z-API real (npm run probe:zapi)
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
