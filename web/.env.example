# URL da API do imobly (processo `npm run dev:api` na raiz do repositório).
# Acessada somente pelo servidor Next (BFF); nunca exposta ao navegador.
# (Nome antigo, ainda aceito: SAAS_API_BASE_URL.)
IMOBLY_API_URL=http://127.0.0.1:3000

# Assina o cookie de sessão do Next.js. Obrigatório em produção (mínimo 32 bytes).
# Deve ser diferente do JWT_SECRET da API.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
