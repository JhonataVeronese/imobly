# URL da API do ImobZap (processo `npm run dev:api` na raiz do repositório).
# Acessada somente pelo servidor Next (BFF); nunca exposta ao navegador.
SAAS_API_BASE_URL=http://127.0.0.1:3000

# Opcional: chave de serviço enviada como X-SAAS-API-Token (padrão do template).
SAAS_API_TOKEN=

# Assina o cookie de sessão do Next.js. Obrigatório em produção (mínimo 32 bytes).
# Deve ser diferente do JWT_SECRET da API.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
